configMaps:
  ipmanager:
    enabled: true
    data:
      Identity__ApiName: "unifi.ipmanager"
      UnifiControllerOptions__Url: "https://unifi.gerega.net"
      UnifiControllerOptions__DnsZone: "gerega.net"
      {{ if ne .Environment.Name "production" }}
      Telemetry__ActivitySourceName: "Unifi.IpManager.{{ title .Values.env_name }}.Activity"
      Telemetry__MeterName: "Unifi.IpManager.{{ title .Values.env_name }}.Meter"
      Telemetry__ServiceName: "Unifi.IpManager.{{ title .Values.env_name }}"
      {{ end }}
  config-js:
    enabled: true
    data:
      config.js: |
        window.unifi_client_api = {
          backend: 'https://api.{{ .Values.environment_hostname }}/unifi/ipmanager',
        };

        window.unifi_client_auth = {
          authority: 'https://auth.{{ .Values.environment_hostname }}/',
          clientId: 'unifiwebclient',
          redirectUri: 'https://uni.{{ .Values.environment_hostname }}',
        };

controllers:
  api:
    containers:
      main:
        image:
          tag: {{ .Values.imageTags.unifi_ipmanager }}
        envFrom:
          - configMapRef:
              name: home-automation-common-config
          - configMapRef:
              identifier: ipmanager
          - secretRef:
              name: unifi-secrets
  frontend:
    containers:
      main:
        image:
          tag: {{ .Values.imageTags.unifi_frontend }}

route:
  api:
    hostnames:
      - api.{{ .Values.environment_hostname }}
  frontend:
    hostnames:
      - uni.{{ .Values.environment_hostname }}
